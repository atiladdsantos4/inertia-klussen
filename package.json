{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build:local": "env-cmd -f .env.devklussen vite build",
        "build:dev": "env-cmd -f .env.devklussen vite build && copy .\\public\\.htaccess_dev.txt .\\public\\build\\.htaccess",
        "build:prod": "env-cmd -f .env.prodklussen vite build && copy .\\public\\.htaccess_dev.txt .\\public\\build\\.htaccess",
        "build:asse": "env-cmd -f .env.klussen vite build && copy .\\public\\.htaccess_dev.txt .\\public\\build\\.htaccess",
        "build": "vite build",
        "dev": "env-cmd -f .env.devklussen vite"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@coreui/coreui": "^5.9.1",
        "@coreui/react": "^5.13.1",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/react-fontawesome": "^3.5.0",
        "@inertiajs/react": "^3.9.1",
        "@vitejs/plugin-react": "^6.1.2",
        "aos": "^2.3.4",
        "axios": "^1.20.0",
        "date-fns": "^4.4.0",
        "date-fns-tz": "^3.2.0",
        "env-cmd": "^11.0.0",
        "imask": "^7.6.1",
        "isotope-layout": "^3.0.6",
        "jquery": "^4.0.0",
        "react": "^19.3.1",
        "react-datepicker": "^9.1.0",
        "react-dom": "^19.3.1",
        "react-imask": "^7.6.1",
        "swiper": "^14.3.0"
    }
